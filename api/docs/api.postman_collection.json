{
  "info": {
    "name": "Lab | Express Social API",
    "_postman_id": "b1e2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Colección de peticiones para el lab de Express Social API.\nBase URL: http://localhost:3000\n\nLas sesiones se gestionan automáticamente mediante cookies — no es necesario copiar tokens a mano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string",
      "description": "Rellena este valor con el id de un post después de crearlo"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string",
      "description": "Rellena este valor con el id de un comentario después de crearlo"
    }
  ],
  "item": [
    {
      "name": "Users & Sessions",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v0/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"username\": \"ada\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Crea un nuevo usuario. Devuelve el usuario creado (sin password) con status 201."
          }
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v0/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Inicia sesión con email y password. Postman guarda la cookie de sesión automáticamente para las siguientes peticiones."
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "sessions"]
            },
            "description": "Destruye la sesión activa. Devuelve 204 sin cuerpo."
          }
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "users", "me"]
            },
            "description": "Devuelve el usuario autenticado con su lista de posts (virtual populate). Requiere sesión activa."
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Listar posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts"]
            },
            "description": "Devuelve todos los posts con el autor populado. Requiere sesión activa."
          }
        },
        {
          "name": "Crear post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mi primer post\",\n  \"body\": \"Este es el contenido de mi primer post en la red social.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Crea un nuevo post. El author se asigna automáticamente desde la sesión. Devuelve el post con el autor populado y status 201.\n\nCopia el campo `id` de la respuesta y pégalo en la variable `postId` de la colección."
          }
        },
        {
          "name": "Detalle de post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts", "{{postId}}"]
            },
            "description": "Devuelve un post con autor y comentarios populados (incluyendo el autor de cada comentario). Requiere sesión activa."
          }
        },
        {
          "name": "Actualizar post",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts", "{{postId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Título actualizado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Actualiza uno o varios campos de un post. Devuelve el documento actualizado."
          }
        },
        {
          "name": "Eliminar post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts", "{{postId}}"]
            },
            "description": "Elimina un post. Devuelve 204 sin cuerpo."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Crear comentario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts", "{{postId}}", "comments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Muy buen post, gracias por compartir!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Crea un comentario en el post indicado. Devuelve el comentario con status 201.\n\nCopia el campo `id` de la respuesta y pégalo en la variable `commentId` de la colección."
          }
        },
        {
          "name": "Eliminar comentario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v0/posts/{{postId}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v0", "posts", "{{postId}}", "comments", "{{commentId}}"]
            },
            "description": "Elimina un comentario. Devuelve 204 sin cuerpo."
          }
        }
      ]
    }
  ]
}
