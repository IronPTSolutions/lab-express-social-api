# Copy this file to .env and fill in the values before running the API.

# Port the API will listen on
PORT=3000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/social-api

# Secret used to sign the session cookie (use a long random string in production)
SESSION_SECRET=super secret

# Set to true only when serving over HTTPS (production)
SESSION_SECURE=false
